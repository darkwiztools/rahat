  "description": "Unified Forensic & Intelligence Suite (UFIS) - Law Enforcement & Defense Edition - Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --clear src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "dev:full": "concurrently -n API,WEB -c blue,cyan \"npm run dev\" \"cd frontend && npm run dev\"",
    "build:full": "npm run build && cd frontend && npm run build"
